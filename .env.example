# Agricultural AI Orchestra - Environment Variables Template
# Copy this file to .env and fill in your actual values

# OpenAI API Key (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
APP_NAME=Agricultural AI Orchestra
APP_VERSION=1.0.0
DEBUG_MODE=False

# Data File Paths
FARM_DATA_FILE=challenge5.json
MARKET_DATA_FILE=challenge5.csv
WEATHER_DATA_FILE=challenge5_weather.csv

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env and add your actual OpenAI API key
# 3. Never commit .env to version control
